# Application Configuration
APP_MODE=api  # Options: api, monitor, training, inference, full
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_SECRET_KEY=your-secret-key-here

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPICS=industrial/sensors/#

# Database Configuration
DB_TYPE=postgresql  # Options: postgresql, mongodb, sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asset_monitoring
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Model Configuration
MODEL_PATH=models/
MODEL_TYPE=lstm  # Options: lstm, autoencoder, cnn, hybrid
MODEL_BATCH_SIZE=32
MODEL_CONFIDENCE_THRESHOLD=0.85

# Alert Configuration
ALERT_EMAIL=alerts@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Inference Configuration
INFERENCE_BACKEND=tensorflow  # Options: tensorflow, torch, onnx
EDGE_DEPLOYMENT=false
EDGE_DEVICE=jetson  # Options: jetson, coral, movidius

# Monitoring Configuration
MONITOR_INTERVAL=10  # seconds
DATA_RETENTION_DAYS=90

# Feature Flags
ENABLE_PREDICTIONS=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_RUL_FORECASTING=true
ENABLE_FEDERATED_LEARNING=false

# Elasticsearch Configuration (for logging)
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=changeme
